HOST=127.0.0.1
PORT=8010
DATABASE_PATH=./data/youtube-reader.sqlite
PUBLIC_URL=https://summaries.example.com

YOUTUBE_API_KEY=
SUPADATA_API_KEY=

# xai or openai
SUMMARY_PROVIDER=xai
SUMMARY_MODEL=grok-4.6
SUMMARY_REASONING_EFFORT=low
XAI_API_KEY=
# OPENAI_API_KEY=

# Set both on a publicly reachable deployment. The WebSub callback remains public.
APP_USERNAME=reader
APP_PASSWORD=
WEBSUB_VERIFY_TOKEN=

MAINTENANCE_INTERVAL_MINUTES=360
WORKER_INTERVAL_SECONDS=15
